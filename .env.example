GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=
STT_TRANSCRIBE_URL=
TTS_BASE_URL=
TTS_CLIENT_ID=
TTS_CLIENT_SECRET=
TTS_VOICE_FEMALE=
TTS_VOICE_MALE=
GAPIAPI=
DENOISE_URL=
GAPI_BASE_URL=
SPEKO_API_KEY=
SPEKO_BASE_URL=
SPEKO_TTS_VOICE=
OPENAI_API_KEY=
OPENAI_MODEL=
SEED_ADMIN_PASSWORD=

# Login: signs the ovoz_session cookie (both apps must use the same value).
OVOZ_SESSION_SECRET=
# Server actions allowed from the public domain (production only).
SERVER_ACTIONS_ALLOWED_ORIGINS=
# Claude: the default answer engine when its key is set (ANTHROPIC_MODEL, default claude-haiku-5-5;
# LLM_PROVIDER=gemini|ollama|openai picks another), and the fallback when a chosen model fails
# (LLM_FALLBACK_MODEL, default claude-haiku-5-5; off turns it off).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_FALLBACK_MODEL=
# Our own models behind the BRB speech proxy (reachable through the BRB VPN).
BRB_SPEECH_URL=
BRB_SPEECH_LOGIN=
BRB_SPEECH_PASSWORD=
# BRB Whisper STT: Triton over gRPC (HTTP/2 + TLS), e.g. https://stt-service.brb.uz; model name, default stt.
BRB_STT_URL=
BRB_STT_MODEL=
# Where Next.js forwards /api/core/* (the Python API); default http://127.0.0.1:8100.
CORE_API_URL=
FILLERS=
