# ─────────────────────────────────────────────────────────────
# Ovoz AI — environment
# Every value below is OPTIONAL. With none of them set the platform
# runs end-to-end on its built-in local engines (see README ▸ Engines).
# ─────────────────────────────────────────────────────────────

# Signing key for session cookies. Auto-generated into data/.secret if unset.
OVOZ_SESSION_SECRET=

# ── Language model ───────────────────────────────────────────
# When set, answer generation switches from the local extractive
# synthesiser to Claude. Everything else keeps working either way.
ANTHROPIC_API_KEY=
# Default claude-opus-5. Voice traffic that needs the lowest possible
# time-to-first-word can set claude-haiku-4-5 here instead.
ANTHROPIC_MODEL=claude-opus-5

# ── Embeddings ───────────────────────────────────────────────
# When set, the hybrid retriever swaps its local hashed-ngram encoder
# for hosted embeddings. Dimensions are detected automatically.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Telephony (Twilio Elastic SIP Trunking) ──────────────────
# Unset ⇒ the built-in call simulator drives the voice pipeline.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=

# ── Speech ───────────────────────────────────────────────────
# Browser Web Speech API is used in the Playground with no key.
# These enable server-side speech for real telephony legs.
GOOGLE_SPEECH_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
